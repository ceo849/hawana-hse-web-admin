  "info": {
    "title": "Hawana HSE Core API",
    "description": "HSE SaaS Core Backend (Multi-tenant)",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "ProvisionTenantDto": {
        "type": "object",
        "properties": {
          "companyName": {
            "type": "string",
            "example": "Hawana Test Company"
          },
          "country": {
            "type": "string",
            "example": "Egypt"
          },
          "industry": {
            "type": "string",
            "example": "HSE"
          },
          "email": {
            "type": "string",
            "example": "owner@hawana.com"
          },
          "password": {
            "type": "string",
            "example": "Hawana@2026",
            "minLength": 8
          },
          "fullName": {
            "type": "string",
            "example": "Company Owner",
            "minLength": 2
          }
        },
        "required": [
          "companyName",
          "email",
          "password",
          "fullName"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "newuser@hawana.com"
          },
          "password": {
            "type": "string",
            "example": "Hawana@2026",
            "minLength": 6
          },
          "fullName": {
            "type": "string",
            "example": "John Doe",
            "minLength": 2
          },
          "companyId": {
            "type": "string",
            "example": "8902fda9-4be2-438a-8a37-50a17861eb52"
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "ADMIN",
              "MANAGER",
              "WORKER",
              "VIEWER"
            ],
            "example": "WORKER"
          }
        },
        "required": [
          "email",
          "password",
          "fullName",
          "companyId",
          "role"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "viewer@hawana.com"
          },
          "password": {
            "type": "string",
            "example": "Hawana@2026",
            "minLength": 6
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "example": "tokenId.secret"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "CreateCheckoutSessionDto": {
        "type": "object",
        "properties": {
          "plan": {
            "type": "string",
            "enum": [
              "BASIC",
              "PROFESSIONAL",
              "ENTERPRISE"
            ]
          }
        },
        "required": [
          "plan"
        ]
      },
      "CreateSitesProjectDto": {
        "type": "object",
        "properties": {}
      },
      "UpdateSitesProjectDto": {
        "type": "object",
        "properties": {}
      },
      "CreateSafetyReportDto": {
        "type": "object",
        "properties": {}
      },
      "UpdateSafetyReportDto": {
        "type": "object",
        "properties": {}
      },
      "CreateActionPlanDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Fix missing guardrail",
            "description": "Short title describing the corrective action"
          },
          "description": {
            "type": "string",
            "example": "Install temporary barrier until permanent fix is completed",
            "description": "Detailed description of the action plan"
          },
          "safetyReportId": {
            "type": "string",
            "example": "28925d55-83c4-4b73-a877-45c82d209528",
            "description": "Related Safety Report ID"
          },
          "assignedToUserId": {
            "type": "string",
            "example": "15fd5c5b-d594-4f08-b20c-0b1fb7262748",
            "description": "Assigned user ID"
          },
          "dueDate": {
            "type": "string",
            "example": "2026-03-01T00:00:00.000Z",
            "description": "Due date (ISO8601)"
          }
        },
        "required": [
          "title",
          "safetyReportId"
        ]
      },
      "UpdateActionPlanDueDateDto": {
        "type": "object",
        "properties": {}
      },
      "CreateIncidentDto": {
        "type": "object",
        "properties": {}
      },
      "CreatePermitToWorkDto": {
        "type": "object",
        "properties": {}
      },
      "UpdatePtwStatusDto": {
        "type": "object",
        "properties": {}
      }
    }
  }
}